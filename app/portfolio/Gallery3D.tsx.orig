"use client";

import React, { useRef, useState, useMemo, useEffect } from "react";
import { Canvas, useFrame } from "@react-three/fiber";
import {
  Html,
  Image as DreiImage,
  Text,
  useCursor,
  MeshTransmissionMaterial,
} from "@react-three/drei";
import * as THREE from "three";
import { easing } from "maath";
import { AnimatePresence, motion } from "motion/react";

function VideoMaterial({ url, hovered }) {
  const video = useMemo(() => {
    const vid = document.createElement("video");
    vid.src = url;
    vid.crossOrigin = "Anonymous";
    vid.loop = true;
    vid.muted = true;
    vid.playsInline = true;
    return vid;
  }, [url]);

  useEffect(() => {
    if (hovered) {
      video.play().catch(() => {});
    } else {
      video.pause();
    }
  }, [hovered, video]);

  const texture = useMemo(() => new THREE.VideoTexture(video), [video]);
  texture.minFilter = THREE.LinearFilter;
  texture.magFilter = THREE.LinearFilter;
  texture.generateMipmaps = false;

  return <meshBasicMaterial map={texture} toneMapped={false} />;
}

function ProjectCard({ project, index, total, radius, onSelect, activeIndex }) {
  const ref = useRef<THREE.Group>(null);
  const meshRef = useRef<THREE.Mesh>(null);
  const [hovered, setHovered] = useState(false);
  useCursor(hovered);

  const angle = (index / total) * Math.PI * 2;
  const baseX = Math.sin(angle) * radius;
  const baseZ = Math.cos(angle) * radius;

  // Constants
  const cardWidth = 3.5;
  const cardHeight = 2.0;

  useFrame((state, delta) => {
    if (!ref.current || !meshRef.current) return;
    // float effect
    const t = state.clock.getElapsedTime();
    const yFloat = Math.sin(t + index * 1000) * 0.1;

    const targetScale = hovered ? 1.15 : 1;
    easing.damp3(
      ref.current.scale,
      [targetScale, targetScale, targetScale],
      0.2,
      delta,
    );

    // Lift forward when hovered by slightly pushing it on its local Z axis
    const pushZ = hovered ? -1 : 0; // Negative Z is forward internally because it faces center?

    ref.current.position.x = baseX;
    ref.current.position.y = yFloat;
    ref.current.position.z = baseZ;
    // Rotate to face outward
    ref.current.rotation.y = angle;

    if (meshRef.current) {
      meshRef.current.position.z = hovered ? 1 : 0;
    }
  });

  return (
    <group ref={ref}>
      <mesh
        ref={meshRef}
        onClick={(e) => {
          e.stopPropagation();
          onSelect(project);
        }}
        onPointerOver={(e) => {
          e.stopPropagation();
          setHovered(true);
        }}
        onPointerOut={() => setHovered(false)}
      >
        <planeGeometry args={[cardWidth, cardHeight]} />
        {hovered && project.video ? (
          <VideoMaterial url={project.video} hovered={hovered} />
        ) : (
          <DreiImage
            url={project.image}
            transparent
            opacity={hovered ? 1 : 0.6}
            toneMapped={false}
          />
        )}

        {/* Glow effect when hovered */}
        <mesh position={[0, 0, -0.01]} scale={hovered ? 1.05 : 1}>
          <planeGeometry args={[cardWidth, cardHeight]} />
          <meshBasicMaterial
            color="#e1591e"
            transparent
            opacity={hovered ? 0.3 : 0}
            blur={10}
          />
        </mesh>
      </mesh>

      <Html
        transform
        position={[0, -1.5, hovered ? -1 : 0]}
        center
        className="pointer-events-none"
      >
        <div
          className={`transition-all duration-500 flex flex-col items-center justify-center ${hovered ? "opacity-100 translate-y-0" : "opacity-0 translate-y-4"}`}
        >
          <h2 className="text-white text-2xl md:text-4xl font-sans font-black uppercase tracking-widest drop-shadow-xl whitespace-nowrap">
            {project.title}
          </h2>
          <p className="text-primary text-xs md:text-sm font-bold tracking-[0.2em] uppercase mt-2">
            {project.tags.join(" • ")}
          </p>
        </div>
      </Html>
    </group>
  );
}

function Carousel({ projects, activeIndex, onSelect }) {
  const group = useRef<THREE.Group>(null);
  const radius = 6.5;

  useFrame((state, delta) => {
    if (!group.current) return;
    const targetRotation = activeIndex * ((Math.PI * 2) / projects.length);
    easing.dampE(group.current.rotation, [0, targetRotation, 0], 0.3, delta);

    // Subtle mouse parallax
    const targetX = (state.pointer.x * Math.PI) / 10;
    const targetY = (state.pointer.y * Math.PI) / 10;
    easing.dampE(
      group.current.rotation,
      [targetY * 0.2, targetRotation + targetX * 0.2, 0],
      0.5,
      delta,
    );
  });

  return (
    <group ref={group}>
      {projects.map((project, i) => (
        <ProjectCard
          key={project.id}
          index={i}
          total={projects.length}
          project={project}
          radius={radius}
          onSelect={onSelect}
          activeIndex={activeIndex}
        />
      ))}
    </group>
  );
}

export default function Gallery3D({ projects }) {
  const [activeIndex, setActiveIndex] = useState(0);
  const [selectedProject, setSelectedProject] = useState(null);

  // Keyboard and wheel navigation
  useEffect(() => {
    const handleWheel = (e: WheelEvent) => {
      if (selectedProject) return;
      if (e.deltaY > 20) {
        setActiveIndex((prev) => Math.min(prev + 1, projects.length - 1));
      } else if (e.deltaY < -20) {
        setActiveIndex((prev) => Math.max(prev - 1, 0));
      }
    };
    window.addEventListener("wheel", handleWheel, { passive: true });
    return () => window.removeEventListener("wheel", handleWheel);
  }, [projects.length, selectedProject]);

  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (selectedProject) {
        if (e.key === "Escape") setSelectedProject(null);
        return;
      }
      if (e.key === "ArrowRight" || e.key === "ArrowDown") {
        setActiveIndex((prev) => Math.min(prev + 1, projects.length - 1));
      }
      if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
        setActiveIndex((prev) => Math.max(prev - 1, 0));
      }
    };
    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, [projects.length, selectedProject]);

  return (
    <>
      <div className="absolute inset-0 w-full h-full z-0 cursor-crosshair bg-background">
        <Canvas camera={{ position: [0, 0, 0], fov: 50 }}>
          <ambientLight intensity={0.2} />
          <pointLight position={[10, 10, 10]} intensity={1} color="#ffffff" />
          <spotLight position={[0, -5, 0]} intensity={2} color="#e1591e" />

          <group position={[0, 0, -6.5]}>
            <Carousel
              projects={projects}
              activeIndex={activeIndex}
              onSelect={setSelectedProject}
            />
          </group>

          {/* Environment reflection */}
          <Environment preset="night" />

          {/* Fog for depth */}
          <fog attach="fog" args={["#000000", 5, 20]} />
        </Canvas>
      </div>

      {/* Navigation Controls Overlay */}
      <div className="absolute bottom-12 left-0 w-full flex justify-center items-center z-10 pointer-events-none">
        <div className="flex gap-4 items-center bg-black/50 backdrop-blur-md px-6 py-3 rounded-full border border-white/10 pointer-events-auto shadow-2xl">
          <button
            onClick={() => setActiveIndex((p) => Math.max(p - 1, 0))}
            className="text-white/50 hover:text-white transition-colors"
            disabled={activeIndex === 0}
          >
            PREV
          </button>
          <div className="text-white/20 text-sm tracking-widest font-mono">
            <span className="text-white">
              {String(activeIndex + 1).padStart(2, "0")}
            </span>{" "}
            / {String(projects.length).padStart(2, "0")}
          </div>
          <button
            onClick={() =>
              setActiveIndex((p) => Math.min(p + 1, projects.length - 1))
            }
            className="text-white/50 hover:text-white transition-colors"
            disabled={activeIndex === projects.length - 1}
          >
            NEXT
          </button>
        </div>
      </div>

      {/* Cinematic Modal */}
      <AnimatePresence>
        {selectedProject && (
          <motion.div
            initial={{ opacity: 0, scale: 0.95 }}
            animate={{ opacity: 1, scale: 1 }}
            exit={{ opacity: 0, scale: 0.95 }}
            transition={{ duration: 0.6, ease: [0.16, 1, 0.3, 1] }}
            className="fixed inset-0 z-50 flex flex-col items-center justify-center bg-black/95 backdrop-blur-xl pointer-events-auto p-4 md:p-12"
          >
            <button
              onClick={() => setSelectedProject(null)}
              className="absolute top-8 right-8 text-white/50 hover:text-white transition-all text-sm tracking-widest uppercase font-bold z-50"
            >
              Close [ ESC ]
            </button>

            <motion.div
              layoutId={`card-${selectedProject.id}`}
              className="w-full max-w-6xl aspect-video bg-zinc-900 rounded-xl overflow-hidden relative shadow-[0_0_50px_rgba(225,89,30,0.15)] ring-1 ring-white/10"
            >
              {selectedProject.video ? (
                <video
                  src={selectedProject.video}
                  autoPlay
                  loop
                  controls
                  className="w-full h-full object-cover"
                />
              ) : (
                <img
                  src={selectedProject.image}
                  alt={selectedProject.title}
                  className="w-full h-full object-cover"
                />
              )}
            </motion.div>

            <div className="w-full max-w-6xl mt-8 flex flex-col md:flex-row justify-between items-start gap-4">
              <div>
                <motion.h1
                  initial={{ opacity: 0, y: 20 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ delay: 0.3 }}
                  className="text-4xl md:text-6xl font-black uppercase text-white tracking-wider"
                >
                  {selectedProject.title}
                </motion.h1>
                <motion.p
                  initial={{ opacity: 0, y: 20 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ delay: 0.4 }}
                  className="text-primary tracking-[0.3em] uppercase text-sm mt-2 font-bold"
                >
                  {selectedProject.subtitle}
                </motion.p>
              </div>

              <motion.div
                initial={{ opacity: 0, x: 20 }}
                animate={{ opacity: 1, x: 0 }}
                transition={{ delay: 0.5 }}
                className="flex gap-3 flex-wrap max-w-sm justify-end"
              >
                {selectedProject.tags.map((tag) => (
                  <span
                    key={tag}
                    className="px-3 py-1 rounded-full border border-white/20 text-white/60 text-xs tracking-wider uppercase"
                  >
                    {tag}
                  </span>
                ))}
                <span className="px-3 py-1 rounded-full bg-white text-black font-bold text-xs tracking-wider uppercase">
                  {selectedProject.year}
                </span>
              </motion.div>
            </div>
          </motion.div>
        )}
      </AnimatePresence>
    </>
  );
}
