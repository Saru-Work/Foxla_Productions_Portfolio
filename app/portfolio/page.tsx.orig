"use client";

import React from "react";
import { motion, AnimatePresence } from "motion/react";
import dynamic from "next/dynamic";
const Gallery3D = dynamic(() => import("./Gallery3D"), { ssr: false });

const PROJECTS = [
  {
    id: "1",
