    image: "https://picsum.photos/seed/video/1200/800",
    video:
      "https://videos.pexels.com/video-files/5961661/5961661-uhd_2560_1440_30fps.mp4",
    tags: ["Directing", "Cinematography"],
  },
  {
    id: "3",
    title: "Commercial ads",
    subtitle: "Automotive Campaign",
    year: "2024",
    image: "https://picsum.photos/seed/promo/1200/800",
    video:
      "https://videos.pexels.com/video-files/5961655/5961655-uhd_2560_1440_30fps.mp4",
    tags: ["Commercial", "VFX"],
